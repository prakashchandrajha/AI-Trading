{
  "nodes": [
    {"id":"file:ai/cockpit.py","type":"file","name":"cockpit.py","filePath":"ai/cockpit.py","summary":"Builds a compact CIO briefing from live market, SmartTrading desk, options, microstructure, risk, and validation inputs. It presents vetted candidates and position context while documenting that discretionary trading decisions remain external to the cockpit.","tags":["decision-cockpit","market-data","risk-context","integration"],"complexity":"complex"},
    {"id":"function:ai/cockpit.py:evaluate_session_clock","type":"function","name":"evaluate_session_clock","filePath":"ai/cockpit.py","lineRange":[65,107],"summary":"Classifies the NSE session window, expiry regime, entry eligibility, and time remaining until the mandatory square-off window.","tags":["market-clock","risk-gate","session-control"],"complexity":"moderate"},
    {"id":"class:ai/cockpit.py:CockpitBuilder","type":"class","name":"CockpitBuilder","filePath":"ai/cockpit.py","lineRange":[110,682],"summary":"Coordinates the read-only desk bridge, live feed, paper ledger, quantitative engines, and strategy analytics into a ranked human-or-agent-readable briefing.","tags":["cockpit","orchestration","market-analysis","decision-support"],"complexity":"complex"},
    {"id":"function:ai/cockpit.py:_fmt_inr","type":"function","name":"_fmt_inr","filePath":"ai/cockpit.py","lineRange":[685,688],"summary":"Formats a signed currency amount for briefing output.","tags":["formatting","currency","utility"],"complexity":"simple"},
    {"id":"function:ai/cockpit.py:format_briefing_text","type":"function","name":"format_briefing_text","filePath":"ai/cockpit.py","lineRange":[691,774],"summary":"Renders the structured cockpit briefing as a concise terminal view for the external CIO agent or operator.","tags":["presentation","briefing","cli-output"],"complexity":"moderate"},

    {"id":"file:ai/gpu_engine.py","type":"file","name":"gpu_engine.py","filePath":"ai/gpu_engine.py","summary":"Provides accelerated quantitative calculations with a safe NumPy CPU fallback when CUDA is unavailable, including option Greeks, probability-of-touch simulation, and correlation heat checks.","tags":["quantitative","monte-carlo","greeks","gpu"],"complexity":"complex"},
    {"id":"class:ai/gpu_engine.py:GPUQuantitativeEngine","type":"class","name":"GPUQuantitativeEngine","filePath":"ai/gpu_engine.py","lineRange":[24,258],"summary":"Runs or falls back from CUDA-based intraday Monte Carlo, vectorized Black-Scholes Greeks, and correlation-risk calculations.","tags":["gpu","monte-carlo","greeks","fallback"],"complexity":"complex"},

    {"id":"file:ai/quantitative_alpha.py","type":"file","name":"quantitative_alpha.py","filePath":"ai/quantitative_alpha.py","summary":"Derives machine-level order-book and dealer-flow features such as micro-price, normalized OFI, VPIN proxy, vanna, charm, and gamma-feedback state.","tags":["microstructure","order-flow","quantitative-alpha","derivatives"],"complexity":"complex"},
    {"id":"function:ai/quantitative_alpha.py:norm_cdf","type":"function","name":"norm_cdf","filePath":"ai/quantitative_alpha.py","lineRange":[19,20],"summary":"Returns the standard normal cumulative distribution value used by option calculations.","tags":["math","normal-distribution","utility"],"complexity":"simple"},
    {"id":"function:ai/quantitative_alpha.py:norm_pdf","type":"function","name":"norm_pdf","filePath":"ai/quantitative_alpha.py","lineRange":[23,24],"summary":"Returns the standard normal probability density used by option calculations.","tags":["math","normal-distribution","utility"],"complexity":"simple"},
    {"id":"class:ai/quantitative_alpha.py:QuantitativeAlphaState","type":"class","name":"QuantitativeAlphaState","filePath":"ai/quantitative_alpha.py","lineRange":[28,47],"summary":"Captures the computed market-microstructure and dealer-flow state for one instrument, including source provenance and machine signal.","tags":["data-model","microstructure","market-state","derivatives"],"complexity":"moderate"},
    {"id":"class:ai/quantitative_alpha.py:QuantitativeAlphaEngine","type":"class","name":"QuantitativeAlphaEngine","filePath":"ai/quantitative_alpha.py","lineRange":[50,327],"summary":"Computes micro-price, lot-normalized five-level OFI, flow toxicity, second-order Greeks, and an interpretable quantitative-alpha state.","tags":["quantitative-alpha","order-flow","greeks","signal-engine"],"complexity":"complex"},

    {"id":"file:ai/smart_edge.py","type":"file","name":"smart_edge.py","filePath":"ai/smart_edge.py","summary":"Computes derived options and market-structure evidence that exceeds retail dashboard views, then returns an interpretable composite edge score for the external CIO to judge.","tags":["decision-support","options-analytics","market-structure","composite-score"],"complexity":"complex"},
    {"id":"class:ai/smart_edge.py:WallFragility","type":"class","name":"WallFragility","filePath":"ai/smart_edge.py","lineRange":[29,36],"summary":"Represents the strength, erosion, and breakout likelihood of an option OI wall.","tags":["data-model","open-interest","wall-analysis"],"complexity":"simple"},
    {"id":"class:ai/smart_edge.py:IVSkewSignal","type":"class","name":"IVSkewSignal","filePath":"ai/smart_edge.py","lineRange":[40,46],"summary":"Represents ATM and OTM implied-volatility skew with an institutional-demand regime label.","tags":["data-model","implied-volatility","skew"],"complexity":"simple"},
    {"id":"class:ai/smart_edge.py:SmartEdgeResult","type":"class","name":"SmartEdgeResult","filePath":"ai/smart_edge.py","lineRange":[50,81],"summary":"Packages wall, OI concentration, IV, volatility, volume, acceleration, and composite-edge evidence for a candidate.","tags":["data-model","decision-support","options-analytics","market-structure"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_wall_fragility","type":"function","name":"compute_wall_fragility","filePath":"ai/smart_edge.py","lineRange":[84,134],"summary":"Scores whether a call or put OI wall is reinforcing or eroding using OI change and ATR-normalized proximity.","tags":["open-interest","wall-analysis","risk-signal"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_oi_herfindahl","type":"function","name":"compute_oi_herfindahl","filePath":"ai/smart_edge.py","lineRange":[137,178],"summary":"Measures option OI concentration across strikes and classifies pinning versus dispersed-trend conditions.","tags":["open-interest","concentration","regime"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_iv_skew","type":"function","name":"compute_iv_skew","filePath":"ai/smart_edge.py","lineRange":[181,256],"summary":"Estimates implied-volatility skew from the option chain and labels fear, complacency, call-demand, or neutral conditions.","tags":["implied-volatility","skew","options-analytics"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_straddle_compression","type":"function","name":"compute_straddle_compression","filePath":"ai/smart_edge.py","lineRange":[259,288],"summary":"Assesses ATM straddle premium relative to spot and realized volatility to identify compression or elevated-fear regimes.","tags":["volatility","straddle","regime"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_relative_volume","type":"function","name":"compute_relative_volume","filePath":"ai/smart_edge.py","lineRange":[291,316],"summary":"Classifies current volume against its average as institutional surge, normal activity, or dead tape.","tags":["volume","liquidity","regime"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_ema_acceleration","type":"function","name":"compute_ema_acceleration","filePath":"ai/smart_edge.py","lineRange":[319,354],"summary":"Calculates the second derivative of EMA slope in ATR units to classify trend acceleration or reversal.","tags":["trend","acceleration","technical-analysis"],"complexity":"moderate"},
    {"id":"function:ai/smart_edge.py:compute_composite_edge","type":"function","name":"compute_composite_edge","filePath":"ai/smart_edge.py","lineRange":[357,488],"summary":"Synthesizes wall, OI, IV, volume, momentum, order-flow, and simulation evidence into a bounded, reasoned edge score.","tags":["composite-score","decision-support","market-structure","risk-signal"],"complexity":"complex"},
    {"id":"function:ai/smart_edge.py:evaluate_smart_edge","type":"function","name":"evaluate_smart_edge","filePath":"ai/smart_edge.py","lineRange":[491,586],"summary":"Builds the complete smart-edge result for a candidate from option-chain, technical, microstructure, and Monte Carlo inputs.","tags":["entry-point","decision-support","options-analytics","composite-score"],"complexity":"complex"}
  ],
