{
  "nodes": [
    {"id":"file:ai/live_kite_feed.py","type":"file","name":"live_kite_feed.py","filePath":"ai/live_kite_feed.py","summary":"Provides a fail-closed Zerodha Kite market-data adapter that resolves instruments and credentials through the read-only SmartTrading bridge. It assembles option-chain, depth, breadth, and historical-bar snapshots for the CIO cockpit without placing orders.","tags":["market-data","kite","fail-closed","read-only"],"complexity":"complex"},
    {"id":"class:ai/live_kite_feed.py:LiveMarketSnapshot","type":"class","name":"LiveMarketSnapshot","filePath":"ai/live_kite_feed.py","lineRange":[43,65],"summary":"Carries one normalized live underlying and option-chain snapshot, including prices, depth, history, volume, and contract mappings.","tags":["data-model","market-data","options"],"complexity":"moderate"},
    {"id":"function:ai/live_kite_feed.py:_extract_5level_depth","type":"function","name":"_extract_5level_depth","filePath":"ai/live_kite_feed.py","lineRange":[68,81],"summary":"Normalizes up to five bid and ask levels from a Kite depth payload into numeric price-quantity tuples.","tags":["utility","order-book","normalization"],"complexity":"simple"},
    {"id":"class:ai/live_kite_feed.py:LiveKiteFeed","type":"class","name":"LiveKiteFeed","filePath":"ai/live_kite_feed.py","lineRange":[84,609],"summary":"Batches live Kite quotes, 5-minute bars, market breadth, instrument metadata, and option chains while failing closed when live data or credentials are unavailable.","tags":["market-data","kite","options","fail-closed"],"complexity":"complex"},
    {"id":"file:ai/logic_tester.py","type":"file","name":"logic_tester.py","filePath":"ai/logic_tester.py","summary":"Runs out-of-sample, regime-aware walk-forward validation over historical NSE bars and archived SmartTrading ticks. It models friction, random nulls, late-session stress, and parameter perturbation to test whether proposed logic is robust.","tags":["backtesting","validation","regime-analysis","anti-curve-fit"],"complexity":"complex"},
    {"id":"function:ai/logic_tester.py:classify_indian_session_regime","type":"function","name":"classify_indian_session_regime","filePath":"ai/logic_tester.py","lineRange":[46,60],"summary":"Classifies a trading session as expiry, high-volatility trend, or normal using Indian expiry-calendar and range rules.","tags":["regime","calendar","classification"],"complexity":"simple"},
    {"id":"function:ai/logic_tester.py:_parse_bar_dt","type":"function","name":"_parse_bar_dt","filePath":"ai/logic_tester.py","lineRange":[63,67],"summary":"Converts a bar timestamp to an Asia/Kolkata-aware datetime for replay logic.","tags":["utility","time-zone","replay"],"complexity":"simple"},
    {"id":"class:ai/logic_tester.py:SimTradeResult","type":"class","name":"SimTradeResult","filePath":"ai/logic_tester.py","lineRange":[71,84],"summary":"Defines the simulated-trade record used to retain entry, exit, regime, friction, return, and exit-reason evidence during validation.","tags":["data-model","backtesting","audit"],"complexity":"simple"},
    {"id":"function:ai/logic_tester.py:_simulate_logic_on_bars","type":"function","name":"_simulate_logic_on_bars","filePath":"ai/logic_tester.py","lineRange":[87,280],"summary":"Replays five-minute sessions without lookahead bias, applies fixed entry and exit physics, and produces friction-adjusted simulated trade results.","tags":["backtesting","simulation","anti-curve-fit","risk"],"complexity":"complex"},
    {"id":"function:ai/logic_tester.py:_summarize_trades","type":"function","name":"_summarize_trades","filePath":"ai/logic_tester.py","lineRange":[283,301],"summary":"Aggregates simulated trades into performance statistics for a logic and regime comparison.","tags":["analytics","backtesting","statistics"],"complexity":"simple"},
    {"id":"function:ai/logic_tester.py:inspect_archived_tick_spread_audit","type":"function","name":"inspect_archived_tick_spread_audit","filePath":"ai/logic_tester.py","lineRange":[304,340],"summary":"Audits archived SmartTrading tick databases for historical depth and spread conditions that qualify replay evidence.","tags":["audit","market-microstructure","historical-data"],"complexity":"moderate"},
    {"id":"function:ai/logic_tester.py:run_logic_validation","type":"function","name":"run_logic_validation","filePath":"ai/logic_tester.py","lineRange":[343,426],"summary":"Coordinates multi-symbol walk-forward validation, null and perturbation controls, and persistence of a compact logic-test report.","tags":["validation","backtesting","reporting","anti-curve-fit"],"complexity":"complex"},
    {"id":"function:ai/logic_tester.py:load_cached_logic_report","type":"function","name":"load_cached_logic_report","filePath":"ai/logic_tester.py","lineRange":[429,435],"summary":"Loads the most recent persisted logic-validation report when it is available.","tags":["reporting","cache","utility"],"complexity":"simple"},
    {"id":"function:ai/logic_tester.py:format_logic_report","type":"function","name":"format_logic_report","filePath":"ai/logic_tester.py","lineRange":[438,467],"summary":"Formats logic-validation metrics and robustness verdicts for an operator-facing report.","tags":["reporting","formatting","validation"],"complexity":"simple"},
    {"id":"file:connector/__init__.py","type":"file","name":"__init__.py","filePath":"connector/__init__.py","summary":"Exposes the SmartTrading bridge as the connector package's public read-only integration surface.","tags":["package","barrel","connector"],"complexity":"simple"},
    {"id":"file:connector/smart_trading_bridge.py","type":"file","name":"smart_trading_bridge.py","filePath":"connector/smart_trading_bridge.py","summary":"Implements the strict read-only boundary from AI-Trading to SmartTrading: HTTP GET telemetry, shared-memory SQLite, ZMQ subscription, data files, and position context. It supplies advisory context and collision data without importing SmartTrading modules or issuing mutations.","tags":["connector","read-only","smarttrading","market-data"],"complexity":"complex"},
    {"id":"function:connector/smart_trading_bridge.py:resolve_smart_trading_root","type":"function","name":"resolve_smart_trading_root","filePath":"connector/smart_trading_bridge.py","lineRange":[28,41],"summary":"Finds the SmartTrading workspace through an environment override or known sibling paths.","tags":["configuration","path-resolution","connector"],"complexity":"simple"},
    {"id":"function:connector/smart_trading_bridge.py:_is_tcp_listening","type":"function","name":"_is_tcp_listening","filePath":"connector/smart_trading_bridge.py","lineRange":[44,50],"summary":"Performs a short loopback probe so unavailable Desk services fail quickly.","tags":["network","health-check","fail-closed"],"complexity":"simple"},
    {"id":"function:connector/smart_trading_bridge.py:_http_get_json","type":"function","name":"_http_get_json","filePath":"connector/smart_trading_bridge.py","lineRange":[53,61],"summary":"Fetches and parses a JSON endpoint using GET only, returning no data on failure.","tags":["http","read-only","utility"],"complexity":"simple"},
    {"id":"function:connector/smart_trading_bridge.py:compute_book_telemetry","type":"function","name":"compute_book_telemetry","filePath":"connector/smart_trading_bridge.py","lineRange":[64,164],"summary":"Derives micro-price, weighted book pressure, lot-normalized order-flow imbalance, spread, and refill warnings from five-level depth.","tags":["market-microstructure","order-book","analytics","options"],"complexity":"complex"},
    {"id":"class:connector/smart_trading_bridge.py:SmartTradingBridge","type":"class","name":"SmartTradingBridge","filePath":"connector/smart_trading_bridge.py","lineRange":[167,638],"summary":"Aggregates read-only SmartTrading credentials, instruments, telemetry, cache, alert, premarket, position, journal, and archived-tick context into one degraded-safe snapshot for the AI CIO.","tags":["connector","read-only","smarttrading","integration"],"complexity":"complex"}
  ],
